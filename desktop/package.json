{
  "name": "ygo-alpha-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "YGO Alpha für den PC: die App mit eingebautem Server und lokalen Daten",
  "author": "YGO Alpha",
  "main": "main.js",
  "scripts": {
    "prepare-server": "node scripts/prepare-server.mjs",
    "start": "electron .",
    "pack": "node scripts/prepare-server.mjs && electron-builder --dir",
    "dist": "node scripts/prepare-server.mjs && electron-builder"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "de.ygo-alpha.desktop",
    "productName": "YGO Alpha",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "phone.html",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/server",
        "to": "server"
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
